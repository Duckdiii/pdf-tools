# Database Connection String for Supabase PostgreSQL (Copy to .env and fill in your values)
DATABASE_CONNECTION_STRING="Host=aws-0-ap-southeast-2.pooler.supabase.com;Port=5432;Database=postgres;Username=your_username;Password=your_password;SSL Mode=Require;Trust Server Certificate=true;"

# OpenAI API Key for Translation Service
OPENAI_API_KEY="your_openai_api_key_here"
